# Server Configuration
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (Inspectable via MongoDB Compass)
MONGODB_URI=mongodb://127.0.0.1:27017/notenest

# JWT Authentication Secret
JWT_SECRET=notenest_production_ready_jwt_super_secret_key_2026_flexi
JWT_EXPIRES_IN=7d

# File Storage Provider: "local" or "cloudinary"
# Defaults to "local" if Cloudinary credentials are not set
STORAGE_PROVIDER=local

# Cloudinary Storage Configuration (Optional - provide if using Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=notenest_uploads

# Admin Registration Secret Key (Protects against unauthorized admin signup)
ADMIN_REGISTRATION_KEY=NoteNest@Admin2026!

